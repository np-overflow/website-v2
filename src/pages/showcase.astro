---
import CarouselFeaturedCard from "../components/CarouselFeaturedCard.astro";
import DefaultLayout from "../layouts/DefaultLayout.astro";
//  Imagine import of data for carousel
let selected = true;
import { getShowcase } from "../lib/api";
const showcase = getShowcase();
const featuredElements = showcase.carousel.length;
---

<DefaultLayout
  seo={{
    title: "Showcase Portal | NP Overflow",
    description:
      "The projects created by members from the Overflow Special Interest Group",
  }}
>
  <div class="w-full p-5 lg:max-w-7xl lg:mx-auto">
    <div class="relative">
      <button
        class="absolute top-1/2 -translate-y-1/2 left-6 p-2 rounded-full bg-[#10101059] z-10"
        onclick="onLeftArrowClick()"
      >
        <img class="h-8 w-8 rotate-180" src="src/images/showcase/arrow.png" />
      </button>
      <button
        class="absolute top-1/2 -translate-y-1/2 right-6 p-2 rounded-full bg-[#10101059] z-10"
        onclick="onRightArrowClick()"
      >
        <img class="h-8 w-8" src="src/images/showcase/arrow.png" />
      </button>

      <div
        class="flex gap-2 absolute bottom-4 justify-center items-center w-full z-10"
      >
        {
          showcase.carousel.map((project, index) => {
            if (index == 0) {
              return (
                <button
                  class="h-[8px] w-[40px] bg-purple-500 rounded-2xl transition-all prev-element"
                  data-index={index}
                  onclick="onPaginationClick(event)"
                />
              );
            } else {
              return (
                <button
                  class="h-[6px] w-[24px] bg-gray-500 rounded-2xl transition-all"
                  data-index={index}
                  onclick="onPaginationClick(event)"
                />
              );
            }
          })
        }

        <!-- The thingy at the bottom to click to the specific featured prj -->
      </div>
      <div
        class="rounded-badge w-full shadow-md relative flex overflow-x-hidden mb-12"
        id="track" data-length={featuredElements}
      >
        {
          showcase.carousel.map((project) => (
            <CarouselFeaturedCard
              title={project.title}
              description={project.description}
              img_name={project.img_name}
              img_alt={project.img_alt}
            />
          ))
        }
        {
          showcase.carousel.map((project) => (
            <CarouselFeaturedCard
              title={project.title}
              description={project.description}
              img_name={project.img_name}
              img_alt={project.img_alt}
            />
          ))
        }

        <!-- This doesn't have to be absolute positioning, prevent text overlap. -->

        <!-- Arrows will have listeners and class names. Only the featured divs are auto-gen -->
      </div>
    </div>

    <!-- Reuse layout -->
    <div>
      <h2>Featured Projects</h2>
      <div class="w-full grid grid-cols-3 gap-8 grid-rows">
        <!-- CSS Grid with 3x3. On md 2x2, on sm 1x1. -->

        <!-- Render tags dynamically, e.g. (FEATURED ON CNA) -->
        <div class="rounded-xl bg-[#3C4043]">
          <img
            class="max-w-full object-cover"
            src="src/images/showcase/drivesim.jpg"
          />
          <div class="p-4 flex-col gap-1">
            <div>
              <!-- Render tags if any -->
            </div>
            <p>Title Project</p>
            <p>By xyz</p>
          </div>
        </div>
        <div class="">
          <img class="max-w-full" src="src/images/showcase/drivesim.jpg" />
          <div class="p-4 flex-col gap-1">
            <div>
              <!-- Render tags if any -->
            </div>
            <p>Title Project</p>
            <p>By xyz</p>
          </div>
        </div>
        <div class="">
          <img class="max-w-full" src="src/images/showcase/drivesim.jpg" />
          <div class="p-4 flex-col gap-1">
            <div>
              <!-- Render tags if any -->
            </div>
            <p>Title Project</p>
            <p>By xyz</p>
          </div>
        </div>
      </div>
    </div>

    <div>
      <h2>Community Projects</h2>
    </div>

    <div>
      <h2>Workshop Projects</h2>
    </div>
  </div>
</DefaultLayout>

<script is:inline>

  

  // Featured Section Carousel: Tracks currentTarget as distance to scroll
  // autoScrollCarousel is used to reinitialize pagination before actually autoscrolling
  // resetTimer contains actual autoscroll functionality, separated to reset
  
  let carouselCards = document.querySelectorAll(".carousel-card")
  console.log(carouselCards)

  carouselCards.forEach(card => {
    let imageDiv = card.querySelector(".image-div")
    card.addEventListener("mouseenter", () => {
      imageDiv.classList.add("scale-[110%]")
    })
    card.addEventListener("mouseleave", () => {
      imageDiv.classList.remove("scale-[110%]")
    })
  });

  let previousElement = document.querySelector(".prev-element");
  let carouselTrack = document.querySelector("#track");
  let featuredElements = carouselTrack.dataset.length
  let carouselClientWidth = carouselTrack.clientWidth;
  let carouselTrackWidth = carouselTrack.offsetWidth;
  let nextPagination;
  let timer;

  carouselTrack.right = -carouselClientWidth * featuredElements;
  carouselTrack.scrollTo({
    left: carouselClientWidth * featuredElements,
    behavior: "instant",
  });
  let currentTarget = carouselClientWidth * featuredElements;

  // Scroll to currentTarget
  let scrollCarousel = () => {
    carouselTrack.scrollTo({
      left: currentTarget,
      behavior: "smooth",
    });
  };

  // Check if carousel is at ridge edge, changes currentTarget back to the front
  let scrollEdgeCheckRight = () => {
    if (currentTarget > carouselTrack.scrollWidth - carouselClientWidth) {
      currentTarget = carouselTrack.scrollWidth - carouselClientWidth;
    }
    if (currentTarget == carouselTrack.scrollLeft) {
      currentTarget = carouselClientWidth * (featuredElements-1);
      carouselTrack.scrollTo({
        left: currentTarget,
        behavior: "instant",
      });
      currentTarget += carouselClientWidth;
      carouselTrack.scrollTo({
        left: currentTarget,
        behavior: "smooth",
      });
    }
  };

  // Check if carousel is at left edge, changes currentTarget back to the front
  let scrollEdgeCheckLeft = () => {
    if (currentTarget < 0) {
      currentTarget = 0;
    }
    if (currentTarget == carouselTrack.scrollLeft) {
      currentTarget = carouselClientWidth * featuredElements;
      carouselTrack.scrollTo({
        left: currentTarget,
        behavior: "instant",
      });
      currentTarget -= carouselClientWidth;
      carouselTrack.scrollTo({
        left: currentTarget,
        behavior: "smooth",
      });
    }
  };

  let onPaginationClick = (event) => {
    let element = event.currentTarget;
    let index = element.dataset.index;
    paginationChange(element, index);
    scrollCarousel();
    autoScrollCarousel();
  };

  // Changes pagination style and currentTarget distance based on position in the carousel and index of button clicked.
  let paginationChange = (element, index) => {
    previousElement.classList.remove(
      "w-[40px]",
      "bg-purple-500",
      "prev-element",
      "h-[8px]",
    );
    previousElement.classList.add("w-[24px]", "bg-gray-500", "h-[6px]");
    element.classList.remove("w-[24px]");
    element.classList.add(
      "w-[40px]",
      "h-[8px]",
      "bg-purple-500",
      "prev-element",
    );
    previousElement = element;

    if (currentTarget < carouselClientWidth * featuredElements) {
      currentTarget = carouselClientWidth * index;
    } else {
      currentTarget = carouselClientWidth * featuredElements + carouselClientWidth * index;
    }
  };

  // Initialises/Resets auto-scroll, and re-initializes pagination to be the next pagination before autoscroll
  let autoScrollCarousel = () => {
    nextPagination =
      previousElement.nextElementSibling ??
      document.querySelector("[data-index='0']");

    clearTimeout(timer);
    timer = setTimeout(() => {
      currentTarget += carouselClientWidth;
      scrollEdgeCheckRight();
      carouselTrack.scrollTo({
        left: currentTarget,
        behavior: "smooth",
      });

      paginationChange(nextPagination, nextPagination.dataset.index);
      autoScrollCarousel();
    }, 6000);
  };

  let onRightArrowClick = () => {
    let nextPagination =
      previousElement.nextElementSibling ??
      document.querySelector("[data-index='0']");
    currentTarget += carouselClientWidth;
    scrollEdgeCheckRight();
    scrollCarousel();
    paginationChange(nextPagination, nextPagination.dataset.index);
    autoScrollCarousel();
  };

  let onLeftArrowClick = () => {
    let nextPagination =
      previousElement.previousElementSibling ??
      document.querySelector(`[data-index='${featuredElements-1}']`);
    currentTarget -= carouselClientWidth;
    scrollEdgeCheckLeft();
    scrollCarousel();
    paginationChange(nextPagination, nextPagination.dataset.index);
    autoScrollCarousel();
  };

  autoScrollCarousel();

  showPopup = (event) => {};
</script>
